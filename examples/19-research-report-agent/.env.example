# OSVA API (live runs)
OSVA_BASE_URL=http://127.0.0.1:8080
OSVA_API_KEY=

# REMOTE_HTTP runtime URL as seen by the OSVA worker (loopback dev)
OSVA_AGENT_RUNTIME_URL=http://127.0.0.1:8799/execute

# MCP connector Streamable HTTP endpoint as seen by the OSVA worker (default loopback demo)
OSVA_MCP_CONNECTOR_URL=http://127.0.0.1:8798/mcp

# Optional: worker-spawned STDIO MCP using @osva-ai/connector-npm (requires worker STDIO opt-in + package on worker)
# OSVA_MCP_CONNECTOR_STDIO=true
# OSVA_MCP_CONNECTOR_STDIO_COMMAND=
# OSVA_MCP_CONNECTOR_STDIO_ARGS_JSON=

# Model profile (prefer an existing version from your deployment)
OSVA_MODEL_PROFILE_VERSION_ID=

# Optional: auto-create a demo ModelProfileVersion (requires deployment provider credentials)
# OSVA_EXAMPLE_MODEL_PROVIDER=OPENAI
# OSVA_EXAMPLE_MODEL_ID=gpt-4o-mini

# Run input
OSVA_EXAMPLE_PACKAGE_NAME=lodash
OSVA_EXAMPLE_INCLUDE_DOWNLOADS=true

# Optional: run a deterministic EvaluationSuite case after a successful fixture run
OSVA_RUN_EVALUATION=false

# Trusted TypeScript deployment (OSVA 1.1+ worker trusted runtime root on the worker host)
# When set, bootstrap copies the built entrypoint into this directory and registers TRUSTED_TYPESCRIPT.
# OSVA_TRUSTED_RUNTIME_ROOT=/var/lib/osva/trusted-runtime

# Local listeners (optional)
# OSVA_EXAMPLE_LISTEN_HOST=127.0.0.1
# OSVA_EXAMPLE_MCP_PORT=8798
# OSVA_EXAMPLE_RUNTIME_PORT=8799
# OSVA_RUN_TIMEOUT_MS=180000
# OSVA_POLL_INTERVAL_MS=500
