# OSVA API (live runs)
OSVA_BASE_URL=http://127.0.0.1:8080
OSVA_API_KEY=

# REMOTE_HTTP runtime URL as seen by the OSVA worker (loopback dev)
OSVA_AGENT_RUNTIME_URL=http://127.0.0.1:8801/execute

# GitHub MCP is STDIO-only (@osva-ai/connector-github). Worker must spawn the connector.
OSVA_MCP_CONNECTOR_STDIO=true
# OSVA_MCP_CONNECTOR_STDIO_COMMAND=
# OSVA_MCP_CONNECTOR_STDIO_ARGS_JSON=

# Worker environment for the spawned connector (never put tokens in transportConfig JSON):
# OSVA_CONNECTOR_GITHUB_TOKEN=<fine-grained PAT with Metadata + Issues read>
# OSVA_CONNECTOR_GITHUB_ALLOWED_REPOSITORIES=owner/repo

# Run input defaults
OSVA_EXAMPLE_REPO_OWNER=Osva-AI
OSVA_EXAMPLE_REPO_NAME=osva-examples
OSVA_EXAMPLE_MAX_ISSUE_SAMPLE=20
# OSVA_EXAMPLE_ISSUE_STATE=open
# OSVA_EXAMPLE_ISSUE_PAGE_LIMIT=1

# Trusted TypeScript deployment (optional)
# OSVA_TRUSTED_RUNTIME_ROOT=/var/lib/osva/trusted-runtime

# OSVA_EXAMPLE_LISTEN_HOST=127.0.0.1
# OSVA_EXAMPLE_RUNTIME_PORT=8801
# OSVA_RUN_TIMEOUT_MS=180000
# OSVA_POLL_INTERVAL_MS=500
