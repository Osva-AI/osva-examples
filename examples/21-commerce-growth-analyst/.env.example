# OSVA API (live runs)
OSVA_BASE_URL=http://127.0.0.1:8080
OSVA_API_KEY=

# REMOTE_HTTP runtime URL as seen by the OSVA worker (loopback dev)
OSVA_AGENT_RUNTIME_URL=http://127.0.0.1:8802/execute

# Shopify + GA4 MCP are STDIO-only on the worker host.
OSVA_MCP_CONNECTOR_STDIO=true
# OSVA_SHOPIFY_MCP_STDIO_COMMAND=
# OSVA_SHOPIFY_MCP_STDIO_ARGS_JSON=
# OSVA_GA4_MCP_STDIO_COMMAND=
# OSVA_GA4_MCP_STDIO_ARGS_JSON=

# Worker environment for spawned connectors (never put secrets in transportConfig JSON):
# OSVA_CONNECTOR_SHOPIFY_SHOP=my-store.myshopify.com
# OSVA_CONNECTOR_SHOPIFY_ACCESS_TOKEN=<read-only Admin API token>
# OSVA_CONNECTOR_GA4_PROPERTY_ID=123456789
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/readonly-service-account.json

# Run input defaults (fixture property ID triggers deterministic offline agent path when runKey=evaluation-fixture)
OSVA_EXAMPLE_START_DATE=2025-06-01
OSVA_EXAMPLE_END_DATE=2025-06-30
OSVA_EXAMPLE_GA4_PROPERTY_ID=fixture-property-424242
OSVA_EXAMPLE_MAX_ORDER_SAMPLE=25
OSVA_EXAMPLE_MAX_PRODUCT_SAMPLE=25
# OSVA_EXAMPLE_ORDER_PAGE_LIMIT=2
# OSVA_EXAMPLE_PRODUCT_PAGE_LIMIT=1
# OSVA_EXAMPLE_GA4_REPORT_LIMIT=50

# Trusted TypeScript deployment (optional)
# OSVA_TRUSTED_RUNTIME_ROOT=/var/lib/osva/trusted-runtime

# OSVA_EXAMPLE_LISTEN_HOST=127.0.0.1
# OSVA_EXAMPLE_RUNTIME_PORT=8802
# OSVA_RUN_TIMEOUT_MS=240000
# OSVA_POLL_INTERVAL_MS=500
