{
  "name": "osva-examples",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=2 build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "pnpm -r --workspace-concurrency=2 typecheck",
    "test": "pnpm -r --workspace-concurrency=2 test",
    "test:utils": "pnpm --filter @osva-examples/utils test",
    "test:examples": "pnpm --filter @osva-examples/01-minimal-agent test && pnpm --filter @osva-examples/02-mcp-tool-agent test && pnpm --filter @osva-examples/03-durable-review-workflow test",
    "example:01": "pnpm --filter @osva-examples/01-minimal-agent start",
    "example:02": "pnpm --filter @osva-examples/02-mcp-tool-agent start",
    "example:03": "pnpm --filter @osva-examples/03-durable-review-workflow start",
    "verify:docs": "node scripts/verify-doc-links.mjs",
    "verify:secrets": "node scripts/verify-secrets.mjs",
    "verify:whitespace": "node scripts/verify-whitespace.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:utils && pnpm test:examples && pnpm build && pnpm verify:docs && pnpm verify:secrets && pnpm verify:whitespace"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.0"
  }
}
